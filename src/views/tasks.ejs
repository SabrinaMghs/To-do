<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1><%= list.name %></h1>

    <a href="/app" class="btn btn-secondary">
        Voltar
    </a>

</div>

<form
    action="/app/<%= list.id %>/tasks"
    method="POST"
    class="card p-3 mb-4 shadow-sm"
>

    <div class="row g-2">

        <div class="col-md-10">

            <input
                type="text"
                name="title"
                class="form-control"
                placeholder="Nova tarefa"
                required
            >

        </div>

        <div class="col-md-2">

            <button class="btn btn-success w-100">
                Adicionar
            </button>

        </div>

    </div>

</form>

<ul class="list-group shadow-sm">

    <% if(list.tasks.length === 0){ %>

        <li class="list-group-item text-center text-light">
            Nenhuma tarefa cadastrada.
        </li>

    <% } %>

    <% list.tasks.forEach(task => { %>

        <li class="list-group-item d-flex justify-content-between align-items-center">

            <div>

                <% if(task.completed){ %>

                    <span class="completed-task">
                        <%= task.title %>
                    </span>

                <% } else { %>

                    <span>
                        <%= task.title %>
                    </span>

                <% } %>

            </div>

            <div class="d-flex gap-2">

                <form
                    action="/app/<%= list.id %>/tasks/<%= task.id %>?_method=PUT"
                    method="POST"
                >

                    <button class="btn btn-warning btn-sm">

                        <% if(task.completed){ %>
                            Desfazer
                        <% } else { %>
                            Concluir
                        <% } %>

                    </button>

                </form>

                <form
                    action="/app/<%= list.id %>/tasks/<%= task.id %>?_method=DELETE"
                    method="POST"
                >

                    <button class="btn btn-danger btn-sm">
                        Excluir
                    </button>

                </form>

            </div>

        </li>

    <% }) %>

</ul>

<%- include('partials/footer') %>